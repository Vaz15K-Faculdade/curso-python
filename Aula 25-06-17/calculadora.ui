  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1,
        stop:0 #2d1f3d,
        stop:1 #1a1a2e);
}

QPushButton {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, 
        stop:0.0 #ff3366,    /* Vermelho rosado */
        stop:0.2 #ff9933,    /* Laranja suave */
        stop:0.4 #ffcc33,    /* Amarelo dourado */
        stop:0.6 #33cc33,    /* Verde esmeralda */
        stop:0.8 #3366ff,    /* Azul royal */
        stop:1.0 #9933ff);   /* Roxo vibrante */
    border-radius: 5px;
    padding: 5px;
    color: white;
    font-weight: bold;
    border: 1px solid rgba(255, 255, 255, 0.2);
}

QPushButton:hover {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, 
        stop:0.0 #ff4d77,
        stop:0.2 #ffad4d,
        stop:0.4 #ffd24d,
        stop:0.6 #4dd24d,
        stop:0.8 #4d77ff,
        stop:1.0 #ad4dff);
}

QLineEdit {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0,
        stop:0 #2e2e4a,
        stop:1 #3d2e4a);
    color: #e0e0e0;
    border: 2px solid #4a3d5a;
    border-radius: 5px;
    padding: 8px;
    font-size: 14px;
}

QListWidget {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0,
        stop:0 #2e2e4a,
        stop:1 #3d2e4a);
    color: #e0e0e0;
    border: 2px solid #4a3d5a;
    border-radius: 5px;
    padding: 5px;
}</string>
